#!/bin/bash
# ==============================================================================
# LEGACYOS - ORGANIZADOR DE ÍCONES DA ÁREA DE TRABALHO
# Gravity codes do xfdesktop: 0=Top-Left, 1=Bottom-Left, 2=Top-Right, 3=Bottom-Right
# ==============================================================================

ALIGN="${1:-right}"

case "$ALIGN" in
    right|direita)
        xfconf-query -c xfce4-desktop -p /desktop-icons/gravity -n -t int -s 2
        ;;
    left|esquerda)
        xfconf-query -c xfce4-desktop -p /desktop-icons/gravity -n -t int -s 0
        ;;
    above|acima)
        xfconf-query -c xfce4-desktop -p /desktop-icons/gravity -n -t int -s 0
        ;;
    below|abaixo)
        xfconf-query -c xfce4-desktop -p /desktop-icons/gravity -n -t int -s 1
        ;;
    *)
        echo "Uso: legacyos-desktop-align [right|left|above|below]"
        exit 1
        ;;
esac

xfdesktop --reload 2>/dev/null || true
exit 0
