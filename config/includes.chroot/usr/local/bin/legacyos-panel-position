#!/bin/bash
# ==============================================================================
# LEGACYOS - GERENCIADOR DE POSIÇÃO DO PAINEL E AJUSTE AUTOMÁTICO DA DOCK
# Usa flags -n -t no xfconf-query para criar propriedades caso ainda não existam
# ==============================================================================

POSITION="${1:-top}"
PLANK_SCHEMA="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"

case "$POSITION" in
    top)
        xfconf-query -c xfce4-panel -p /panels/panel-1/position -n -t string -s "p=6;x=0;y=0"
        xfconf-query -c xfce4-panel -p /panels/panel-1/mode -n -t int -s 0
        xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s 32
        xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -n -t bool -s true
        gsettings set "$PLANK_SCHEMA" position 'bottom' 2>/dev/null || true
        gsettings set "$PLANK_SCHEMA" offset 0 2>/dev/null || true
        ;;
    bottom)
        xfconf-query -c xfce4-panel -p /panels/panel-1/position -n -t string -s "p=12;x=0;y=0"
        xfconf-query -c xfce4-panel -p /panels/panel-1/mode -n -t int -s 0
        xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s 32
        xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -n -t bool -s true
        gsettings set "$PLANK_SCHEMA" position 'bottom' 2>/dev/null || true
        gsettings set "$PLANK_SCHEMA" offset 36 2>/dev/null || true
        ;;
    left)
        xfconf-query -c xfce4-panel -p /panels/panel-1/position -n -t string -s "p=3;x=0;y=0"
        xfconf-query -c xfce4-panel -p /panels/panel-1/mode -n -t int -s 1
        xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s 42
        xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -n -t bool -s true
        gsettings set "$PLANK_SCHEMA" position 'bottom' 2>/dev/null || true
        gsettings set "$PLANK_SCHEMA" offset 0 2>/dev/null || true
        ;;
    right)
        xfconf-query -c xfce4-panel -p /panels/panel-1/position -n -t string -s "p=9;x=0;y=0"
        xfconf-query -c xfce4-panel -p /panels/panel-1/mode -n -t int -s 1
        xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s 42
        xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -n -t bool -s true
        gsettings set "$PLANK_SCHEMA" position 'bottom' 2>/dev/null || true
        gsettings set "$PLANK_SCHEMA" offset 0 2>/dev/null || true
        ;;
    *)
        echo "Uso: legacyos-panel-position [top|bottom|left|right]"
        exit 1
        ;;
esac

xfce4-panel --restart >/dev/null 2>&1 &
exit 0
