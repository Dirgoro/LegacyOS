#!/bin/bash
# ==============================================================================
# LEGACYOS - WRAPPER DE SESSÃO GRÁFICA
# Libera o framebuffer do Plymouth e inicia a sessão XFCE sem bloqueios
# ==============================================================================

export DISPLAY="${DISPLAY:-:0}"

# Define fundo Dark Slate imediato no servidor X
xsetroot -solid "#0F141C" 2>/dev/null || true

# Encerra o Plymouth liberando o dispositivo de vídeo para o Xorg
plymouth quit 2>/dev/null || true

# Inicia a sessão completa do XFCE
exec /usr/bin/xfce4-session
