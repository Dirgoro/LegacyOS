#!/bin/bash
# ==============================================================================
# LEGACYOS - WRAPPER DE SESSÃO GRÁFICA
# Encerra o splash do Plymouth e inicia o XFCE de forma limpa e sem travamentos
# ==============================================================================

export DISPLAY="${DISPLAY:-:0}"

# Define a cor de fundo padrão para evitar piscar tela branca
xsetroot -solid "#0F141C" 2>/dev/null || true

# Encerra o Plymouth liberando totalmente o framebuffer para o Xorg
plymouth quit 2>/dev/null || true

# Inicia o ambiente gráfico XFCE
exec /usr/bin/xfce4-session
