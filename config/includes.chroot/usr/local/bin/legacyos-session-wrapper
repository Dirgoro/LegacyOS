#!/bin/bash
# ==============================================================================
# LEGACYOS - WRAPPER DE SESSÃO GRÁFICA
# Garante barramento D-Bus ativo, tema Dark Slate e inicialização limpa do XFCE
# ==============================================================================

export DISPLAY="${DISPLAY:-:0}"
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GTK_THEME="LegacyOS-Theme"
export QT_QPA_PLATFORMTHEME="qt5ct"

# Define fundo Dark Slate imediato antes do xfdesktop assumir
xsetroot -solid "#0F141C" 2>/dev/null || true

# Garante diretório de configuração com permissões do usuário atual
XFCONF_DIR="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$XFCONF_DIR"

if [ ! -f "$XFCONF_DIR/xfwm4.xml" ]; then
    cat << 'EOF' > "$XFCONF_DIR/xfwm4.xml"
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="LegacyOS-Theme"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="vblank_mode" type="string" value="off"/>
  </property>
</channel>
EOF
fi

if [ ! -f "$XFCONF_DIR/xsettings.xml" ]; then
    cat << 'EOF' > "$XFCONF_DIR/xsettings.xml"
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="LegacyOS-Theme"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Geist 9.5"/>
  </property>
</channel>
EOF
fi

# Inicia o XFCE garantindo um barramento D-Bus ativo
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- /usr/bin/startxfce4
else
    exec /usr/bin/startxfce4
fi
