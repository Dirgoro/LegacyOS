#!/bin/bash
set -e

# 1. Cria o usuário se não existir
if ! id -u user >/dev/null 2>&1; then
    useradd -m -s /bin/bash user
    adduser user sudo || true
fi

# 2. Gera o hash da senha 'live' usando Python (ignora o PAM)
HASH=$(python3 -c 'import crypt; print(crypt.crypt("live", crypt.mksalt(crypt.METHOD_SHA512)))')

# 3. Aplica o hash diretamente no usuário
usermod -p "$HASH" user

# 4. Força o auto-login no LightDM
mkdir -p /etc/lightdm/lightdm.conf.d
cat << 'EOF' > /etc/lightdm/lightdm.conf.d/50-autologin.conf
[Seat:*]
autologin-user=user
autologin-user-timeout=0
user-session=xfce
EOF
