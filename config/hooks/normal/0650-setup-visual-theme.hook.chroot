#!/bin/bash
# ==============================================================================
# LEGACYOS - HOOK DE TEMA VISUAL E CONFIGURAÇÃO LIMPA DO LIGHTDM / XFCE
# ==============================================================================

set -e

XFWM_DIR="/usr/share/themes/LegacyOS-Theme/xfwm4"
mkdir -p "$XFWM_DIR"

echo "[LegacyOS Hook 0650] Configurando ativos visuais base..."

cat << 'EOF' > "$XFWM_DIR/title-1-active.xpm"
/* XPM */
static char * title_1_active_xpm[] = {
"1 30 2 1",
" 	c #0F141C",
".	c #19212D",
".",
" "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "};
EOF

for N in 2 3 4 5; do
    cp "$XFWM_DIR/title-1-active.xpm" "$XFWM_DIR/title-${N}-active.xpm"
done

cat << 'EOF' > "$XFWM_DIR/title-1-inactive.xpm"
/* XPM */
static char * title_1_inactive_xpm[] = {
"1 30 2 1",
" 	c #0B0F16",
".	c #141A23",
".",
" "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "};
EOF

for N in 2 3 4 5; do
    cp "$XFWM_DIR/title-1-inactive.xpm" "$XFWM_DIR/title-${N}-inactive.xpm"
done

cp "$XFWM_DIR/title-1-active.xpm" "$XFWM_DIR/top-left-active.xpm"
cp "$XFWM_DIR/title-1-active.xpm" "$XFWM_DIR/top-right-active.xpm"
cp "$XFWM_DIR/title-1-inactive.xpm" "$XFWM_DIR/top-left-inactive.xpm"
cp "$XFWM_DIR/title-1-inactive.xpm" "$XFWM_DIR/top-right-inactive.xpm"

cat << 'EOF' > "$XFWM_DIR/left-active.xpm"
/* XPM */
static char * border_xpm[] = {
"1 1 1 1",
".	c #19212D",
"."};
EOF

for SIDE in right bottom bottom-left bottom-right; do
    cp "$XFWM_DIR/left-active.xpm" "$XFWM_DIR/${SIDE}-active.xpm"
done

cat << 'EOF' > "$XFWM_DIR/left-inactive.xpm"
/* XPM */
static char * border_inact_xpm[] = {
"1 1 1 1",
".	c #141A23",
"."};
EOF

for SIDE in right bottom bottom-left bottom-right; do
    cp "$XFWM_DIR/left-inactive.xpm" "$XFWM_DIR/${SIDE}-inactive.xpm"
done

cat << 'EOF' > "$XFWM_DIR/close-active.xpm"
/* XPM */
static char * close_active_xpm[] = {
"18 30 3 1",
" 	c #0F141C",
".	c #19212D",
"+	c #94A3B8",
"..................","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"     +      +     ","      +    +      ","       +  +       ","        ++        ","        ++        ",
"       +  +       ","      +    +      ","     +      +     ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  "};
EOF

sed 's/#94A3B8/#EF4444/' "$XFWM_DIR/close-active.xpm" > "$XFWM_DIR/close-prelight.xpm"
sed 's/#94A3B8/#DC2626/' "$XFWM_DIR/close-active.xpm" > "$XFWM_DIR/close-pressed.xpm"
sed -e 's/#0F141C/#0B0F16/' -e 's/#19212D/#141A23/' -e 's/#94A3B8/#475569/' "$XFWM_DIR/close-active.xpm" > "$XFWM_DIR/close-inactive.xpm"

cat << 'EOF' > "$XFWM_DIR/maximize-active.xpm"
/* XPM */
static char * max_active_xpm[] = {
"18 30 3 1",
" 	c #0F141C",
".	c #19212D",
"+	c #94A3B8",
"..................","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"     ++++++++     ","     +      +     ","     +      +     ","     +      +     ","     +      +     ",
"     +      +     ","     +      +     ","     ++++++++     ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  "};
EOF

sed 's/#94A3B8/#F8FAFC/' "$XFWM_DIR/maximize-active.xpm" > "$XFWM_DIR/maximize-prelight.xpm"
sed 's/#94A3B8/#137FEC/' "$XFWM_DIR/maximize-active.xpm" > "$XFWM_DIR/maximize-pressed.xpm"
sed -e 's/#0F141C/#0B0F16/' -e 's/#19212D/#141A23/' -e 's/#94A3B8/#475569/' "$XFWM_DIR/maximize-active.xpm" > "$XFWM_DIR/maximize-inactive.xpm"

cat << 'EOF' > "$XFWM_DIR/hide-active.xpm"
/* XPM */
static char * hide_active_xpm[] = {
"18 30 3 1",
" 	c #0F141C",
".	c #19212D",
"+	c #94A3B8",
"..................","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","     ++++++++     ",
"     ++++++++     ","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  "};
EOF

sed 's/#94A3B8/#F8FAFC/' "$XFWM_DIR/hide-active.xpm" > "$XFWM_DIR/hide-prelight.xpm"
sed 's/#94A3B8/#137FEC/' "$XFWM_DIR/hide-active.xpm" > "$XFWM_DIR/hide-pressed.xpm"
sed -e 's/#0F141C/#0B0F16/' -e 's/#19212D/#141A23/' -e 's/#94A3B8/#475569/' "$XFWM_DIR/hide-active.xpm" > "$XFWM_DIR/hide-inactive.xpm"

cat << 'EOF' > "$XFWM_DIR/menu-active.xpm"
/* XPM */
static char * menu_active_xpm[] = {
"18 30 3 1",
" 	c #0F141C",
".	c #19212D",
"+	c #137FEC",
"..................","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"       ++++       ","      ++++++      ","      ++++++      ","      ++++++      ","      ++++++      ",
"       ++++       ","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  ",
"                  ","                  ","                  ","                  ","                  "};
EOF

cp "$XFWM_DIR/menu-active.xpm" "$XFWM_DIR/menu-prelight.xpm"
cp "$XFWM_DIR/menu-active.xpm" "$XFWM_DIR/menu-pressed.xpm"
sed -e 's/#0F141C/#0B0F16/' -e 's/#19212D/#141A23/' -e 's/#137FEC/#475569/' "$XFWM_DIR/menu-active.xpm" > "$XFWM_DIR/menu-inactive.xpm"

# ------------------------------------------------------------------------------
# Configuração padrão GTK e XFWM4 (sem compositor para garantir renderização VM)
# ------------------------------------------------------------------------------
mkdir -p /etc/skel/.config/gtk-3.0 /etc/skel/.config/gtk-4.0
cat << 'EOF' > /etc/skel/.config/gtk-3.0/settings.ini
[Settings]
gtk-theme-name=LegacyOS-Theme
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme=1
EOF
cp /etc/skel/.config/gtk-3.0/settings.ini /etc/skel/.config/gtk-4.0/settings.ini

SKEL_XFCONF="/etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$SKEL_XFCONF"

cat << 'EOF' > "$SKEL_XFCONF/xfwm4.xml"
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="LegacyOS-Theme"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="vblank_mode" type="string" value="off"/>
  </property>
</channel>
EOF

cat << 'EOF' > "$SKEL_XFCONF/xsettings.xml"
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="LegacyOS-Theme"/>
    <property name="IconThemeName" type="string" value="Papirus-Dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Noto Sans 10"/>
  </property>
</channel>
EOF

# ------------------------------------------------------------------------------
# LightDM limpo e sessão XFCE padrão (sem wrappers intermediários)
# ------------------------------------------------------------------------------
mkdir -p /etc/lightdm/lightdm.conf.d
cat << 'EOF' > /etc/lightdm/lightdm.conf.d/50-legacyos.conf
[LightDM]
logind-check-graphical=false

[Seat:*]
user-session=xfce
greeter-session=lightdm-gtk-greeter
EOF

if [ -f "/usr/share/xsessions/xfce.desktop" ]; then
    sed -i 's|^Exec=.*|Exec=startxfce4|' /usr/share/xsessions/xfce.desktop
fi

echo "[LegacyOS Hook 0650] Hook visual base concluído."
exit 0
