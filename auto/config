#!/bin/sh

set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootloaders "syslinux,grub-efi" \
    --debian-installer false \
    --apt-recommends false \
    --apt-indices false \
    --memtest none \
    --win32-loader false \
    --iso-application "LegacyOS 1.0" \
    --iso-publisher "LegacyOS Project" \
    --iso-volume "LegacyOS_1_0" \
    --bootappend-live "boot=live components locales=pt_BR.UTF-8 keyboard-layouts=br timezone=America/Sao_Paulo quiet splash" \
    "${@}"
